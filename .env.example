JWT_SECRET=<generate-a-strong-shared-secret>
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable
DB_CHANNEL_BINDING=disable
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kelolakelas_identity
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default
REDIS_TLS=false
REDIS_DB=0
PORT=8080
APP_URL=http://localhost:3000
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
PASSWORD_RESET_TTL_MINUTES=60
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_GEOCODING_ENABLED=false
GOOGLE_MAPS_TIMEOUT_SECONDS=5
# HTTP server timeouts in seconds; zero, negative, or unset uses the default shown.
SERVER_READ_HEADER_TIMEOUT_SECONDS=5
SERVER_READ_TIMEOUT_SECONDS=30
SERVER_WRITE_TIMEOUT_SECONDS=60
SERVER_IDLE_TIMEOUT_SECONDS=120
# How long HTTP Shutdown and gRPC GracefulStop may drain after SIGINT/SIGTERM before a
# forced stop; zero, negative, or unset uses 15.
SERVER_SHUTDOWN_TIMEOUT_SECONDS=15
